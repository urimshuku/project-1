# Copy to `.env.secrets` and fill in (that file is gitignored).
# Push to Supabase:
#   npx supabase secrets set --env-file supabase/.env.secrets
#
RESEND_API_KEY=re_your_key_from_resend
BOOKING_ADMIN_EMAIL=you@yourdomain.com
# Optional — override default "From" in email.ts
# BOOKING_FROM_EMAIL=Studio Space <bookings@studiospace.community>
