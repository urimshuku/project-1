# Copy this file to .env and fill in your values.
# Restart the dev server (npm run dev) after changing .env.

# Supabase (required for Paysera checkout and venue booking form)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Venue booking calls Edge Function: POST /functions/v1/book-venue
# In Supabase Dashboard → Edge Functions → book-venue → Secrets, set at least:
#   SUPABASE_SERVICE_ROLE_KEY (recommended for DB inserts; anon alone may fail if RLS has no insert policy)
#   RESEND_API_KEY
# Edge Function secrets (set in Supabase Dashboard or: npx supabase secrets set KEY=value):
#   RESEND_API_KEY
#   BOOKING_ADMIN_EMAIL
#   BOOKING_FROM_EMAIL (optional)
# SUPABASE_SERVICE_ROLE_KEY is usually already present for other functions.
